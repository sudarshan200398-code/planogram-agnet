# Copy to .streamlit/secrets.toml (never commit that file), or paste into
# Streamlit Cloud > App settings > Secrets. Top-level values become environment variables.

# "none" keeps the AI model off (simple rules only); "gemini" turns it on.
PLANOGRAM_PROVIDER = "none"

# Only needed when PLANOGRAM_PROVIDER = "gemini".
GEMINI_API_KEY = "your-gemini-api-key-here"
