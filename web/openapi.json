    "/stores/{store_id}/products/{sku}/image": {
      "get": {
        "tags": [
          "catalogue"
        ],
        "summary": "Product Picture",
        "operationId": "product_picture_stores__store_id__products__sku__image_get",
        "parameters": [
          {
            "name": "store_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Store Id"
            }
          },
          {
            "name": "sku",
            "in": "path",
            "required": true,
