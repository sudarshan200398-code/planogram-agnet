    "/stores/{store_id}/search": {
      "post": {
        "tags": [
          "search"
        ],
        "summary": "Search",
        "description": "The full request pipeline on typed text (start phrases, quantities, lists, typos).",
        "operationId": "search_stores__store_id__search_post",
        "parameters": [
          {
            "name": "store_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Store Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "422": {
            "content": {
