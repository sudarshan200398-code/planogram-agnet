                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not Found"
          }
        }
      }
    },
    "/stores/{store_id}/clarify": {
      "post": {
        "tags": [
          "search"
        ],
        "summary": "Clarify",
        "description": "Answer the pending question from /search or /basket/route with one of its offered skus.",
        "operationId": "clarify_stores__store_id__clarify_post",
        "parameters": [
          {
            "name": "store_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Store Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
