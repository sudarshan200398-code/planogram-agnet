        "type": "object",
        "required": [
          "sku",
          "qty"
        ],
        "title": "BasketLine"
      },
      "BasketRouteRequest": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/BasketLine"
