                }
              }
            },
            "description": "Conflict"
          }
        }
      }
    },
    "/stores/{store_id}/basket/route": {
      "post": {
        "tags": [
          "search"
        ],
        "summary": "Basket Route",
        "description": "Route for a basket of skus, through the same pipeline as typed text, without the AI model.",
        "operationId": "basket_route_stores__store_id__basket_route_post",
        "parameters": [
          {
            "name": "store_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Store Id"
